{
  "name": "custom-mygrid-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-site.mjs && astro dev --root site --host 127.0.0.1",
    "build": "node scripts/sync-upstream.mjs && node scripts/prepare-site.mjs && astro build --root site",
    "preview": "astro preview --root site --host 127.0.0.1",
    "test": "node --test scripts/site-links.test.mjs scripts/snapshot-files.test.mjs",
    "check:site": "python3 scripts/check-site.py",
    "docs:update": "node scripts/sync-upstream.mjs --update",
    "docs:verify": "node scripts/sync-upstream.mjs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "astro": "7.4.7"
  }
}
