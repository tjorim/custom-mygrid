---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { documentRoute, siteUrl, repository } from '../../../lib/paths.mjs';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../../../docs/*.md', { eager: true });
  const website = import.meta.glob('../../../README.md', { eager: true });
  return Object.entries({ ...modules, ...website }).map(([file, doc]) => {
    const source = file.endsWith('../../../README.md') ? 'site/README.md' : `docs/${file.split('/').pop()}`;
    const slug = documentRoute(source).slice(5).replace(/\/$/, '') || undefined;
    return { params: { slug }, props: { doc, source } };
  });
}
const { doc, source } = Astro.props;
const { Content, getHeadings } = doc;
const headings = getHeadings();
const title = headings.find(heading => heading.depth === 1)?.text ?? 'Documentation';
const pages = [
  ['docs/README.md', 'Overview'],
  ['docs/moduletwo.md', 'ModuleTwo setup'],
  ['docs/voltbridge.md', 'VoltBridge setup'],
  ['docs/voltbridge-api.md', 'VoltBridge API'],
  ['docs/architecture.md', 'Architecture'],
  ['site/README.md', 'Website development'],
];
---
<SiteLayout title={`${title} · custom-mygrid`} documentation>
  <main id="main" tabindex="-1" class="wrap docs-layout">
    <aside class="docs-sidebar">
      <a href={siteUrl()}>← Back to home</a>
      <nav aria-label="Documentation">
        {pages.map(([file, label]) => <a href={siteUrl(documentRoute(file))} aria-current={file === source ? 'page' : undefined}>{label}</a>)}
      </nav>
      {headings.some(h => h.depth === 2) && <details class="toc" open>
        <summary>On this page</summary>
        <ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </details>}
    </aside>
    <article class="prose">
      <div class="source-links"><a href={`${repository}/blob/main/${source}`}>View Markdown source ↗</a><a href={`${repository}/edit/main/${source}`}>Edit on GitHub ↗</a></div>
      <Content />
    </article>
  </main>
</SiteLayout>
