---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteUrl } from '../../lib/paths.mjs';
---
<SiteLayout title="Page not found · custom-mygrid" noindex>
  <main id="main" tabindex="-1" class="hero wrap">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>This page does not exist.</h1>
    <p class="intro">The link may be out of date. Start from the home page or browse the documentation.</p>
    <a class="button" href={siteUrl()}>Back to home <span aria-hidden="true">→</span></a>
    <a class="button" href={siteUrl('docs/')}>Documentation <span aria-hidden="true">→</span></a>
  </main>
</SiteLayout>
